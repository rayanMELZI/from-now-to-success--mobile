<?xml version="1.0" encoding="utf-8"?>
<!-- One line of the plan: the time it is done by, the dot, the title. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/fnts_item_root"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:minHeight="36dp"
  android:orientation="horizontal"
  android:paddingStart="6dp"
  android:paddingTop="4dp"
  android:paddingEnd="6dp"
  android:paddingBottom="4dp">

  <TextView
    android:id="@+id/fnts_item_time"
    android:layout_width="42dp"
    android:layout_height="wrap_content"
    android:fontFeatureSettings="tnum"
    android:gravity="end"
    android:textColor="@color/fnts_widget_ink"
    android:textSize="13sp"
    android:textStyle="bold" />

  <ImageView
    android:id="@+id/fnts_item_dot"
    android:layout_width="18dp"
    android:layout_height="18dp"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:importantForAccessibility="no" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/fnts_item_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/fnts_widget_ink"
      android:textSize="14sp" />

    <TextView
      android:id="@+id/fnts_item_habit"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/fnts_widget_accent_ink"
      android:textSize="11sp"
      android:visibility="gone" />
  </LinearLayout>
</LinearLayout>
